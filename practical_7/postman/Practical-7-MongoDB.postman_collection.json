{
  "info": {
    "_postman_id": "65b5f6d1-7b07-4c2e-8bd9-000000000007",
    "name": "Practical 7 - MongoDB Student CRUD",
    "description": "Tests health, create, read, update and delete for the Node + Express + MongoDB application. Set baseUrl to your local or deployed URL.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "studentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Health - MongoDB connection",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('MongoDB health status is OK', function () { pm.response.to.have.status(200); });",
              "pm.test('Database reports connected', function () { pm.expect(pm.response.json().database).to.include('connected'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Create student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Rugved Suryawanshi\",\n  \"email\": \"{{studentEmail}}\",\n  \"course\": \"Software Engineering\",\n  \"year\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/students"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('studentEmail', 'rugved+practical7-' + Date.now() + '@example.com');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Student created', function () { pm.response.to.have.status(201); });",
              "const json = pm.response.json();",
              "if (json.data && json.data._id) pm.collectionVariables.set('studentId', json.data._id);",
              "pm.test('Created record has MongoDB ID', function () { pm.expect(json.data._id).to.be.a('string'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Read all students",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/students"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('List returns 200', function () { pm.response.to.have.status(200); });",
              "pm.test('List has count and data', function () { const json = pm.response.json(); pm.expect(json.count).to.be.a('number'); pm.expect(json.data).to.be.an('array'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Read created student",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/students/{{studentId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('One student returned', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().data._id).to.eql(pm.collectionVariables.get('studentId')); });"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Update created student",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"course\": \"Advanced Web Technology\",\n  \"year\": 3\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/students/{{studentId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Student updated', function () { pm.response.to.have.status(200); const json = pm.response.json(); pm.expect(json.data.course).to.eql('Advanced Web Technology'); pm.expect(json.data.year).to.eql(3); });"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Delete created student",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/students/{{studentId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Student deleted', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Verify deleted student returns 404",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/students/{{studentId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Deleted record is not found', function () { pm.response.to.have.status(404); });",
              "pm.collectionVariables.unset('studentId');"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Validation - reject invalid email",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test Student\",\n  \"email\": \"not-an-email\",\n  \"course\": \"Software Engineering\",\n  \"year\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/students"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Invalid email is rejected', function () { pm.response.to.have.status(400); pm.expect(pm.response.json().error).to.eql('Validation failed'); });"
            ]
          }
        }
      ]
    }
  ]
}
