PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/college_club_management
# Use a random secret at least 24 characters long.
JWT_SECRET=replace-with-a-long-random-secret-of-32-or-more-characters
CLIENT_URL=http://localhost:5173
# Optional comma-separated additional frontend origins.
CLIENT_URLS=

# Local development: Gmail SMTP (requires a Gmail App Password).
EMAIL_PROVIDER=smtp
EMAIL_USER=your-email@gmail.com
EMAIL_APP_PASSWORD=your-gmail-app-password

# Hosted on Render Free: use the HTTPS email API instead of SMTP.
# Create a Brevo API key and verify a sender address in Brevo, then set:
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=your-brevo-api-key
# EMAIL_FROM=your-verified-sender@example.com
# EMAIL_FROM_NAME=ClubSphere
